#!/usr/bin/env bash
# /usr/lib/systemd/system-sleep/ms912x-wake
# Hook de resume para adaptador MacroSilicon MS912x
# Se ejecuta como root al salir de suspensión/hibernación

case "${1:-}" in
    post)
        # post-suspend: $2 = suspend|hibernate
        # Ejecutar y esperar completado (sin background &) para asegurar que
        # la danza completa termine antes de que KWin reaplique config
        MS912X_WAIT_WAYLAND=1 /home/davidu14/.local/bin/ms912x-wake.sh
        ;;
esac